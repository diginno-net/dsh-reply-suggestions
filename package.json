{
  "name": "dsh-reply-suggestions",
  "version": "0.1.5",
  "icon": "./icon.png",
  "description": "Suggest your next question from the conversation. Press Enter to fill it in, then edit and send.",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "files": [
    "icon.png",
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "README_EN.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jabingu/dsh-reply-suggestions.git"
  },
  "homepage": "https://github.com/jabingu/dsh-reply-suggestions#readme",
  "bugs": {
    "url": "https://github.com/jabingu/dsh-reply-suggestions/issues"
  }
}
