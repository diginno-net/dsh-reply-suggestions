{
  "name": "dsh-reply-suggestions",
  "version": "0.1.17-diginno.1",
  "icon": "./icon.png",
  "description": "Suggest your next question from the conversation. Press Enter to fill it in, then edit and send.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.5"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs"
  },
  "files": [
    "icon.png",
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "MAINTENANCE.md",
    "LICENSE",
    "README_EN.md",
    "README_ZH.md",
    "VERIFICATION.md",
    "assets/reply-suggestions-demo-0.1.16.png"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diginno-net/dsh-reply-suggestions.git"
  },
  "homepage": "https://github.com/diginno-net/dsh-reply-suggestions#readme",
  "bugs": {
    "url": "https://github.com/diginno-net/dsh-reply-suggestions/issues"
  }
}
